{
  "name": "mtrajk-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "validate:content": "node scripts/validate-content.mjs",
    "generate": "node scripts/generate-validator.mjs",
    "typecheck": "npm run generate && tsc -p jsconfig.json",
    "lint": "eslint src scripts tests *.js",
    "test": "npm run generate && node --test tests/core.test.js tests/content.test.js tests/cli.test.js",
    "build": "node scripts/build.mjs && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "node scripts/preview.mjs",
    "dev": "npm run build && npm run preview",
    "test:e2e": "playwright test",
    "test:cli": "node --test tests/package.test.js",
    "check": "npm run validate:content && npm run typecheck && npm run lint && npm test && npm run build && npm run test:cli",
    "assets:portrait": "node scripts/prepare-portrait.mjs",
    "audit:performance": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "ajv": "8.20.0",
    "esbuild": "0.25.10",
    "eslint": "10.10.0",
    "lighthouse": "13.5.0",
    "prettier": "3.6.2",
    "sharp": "^0.35.5",
    "typescript": "5.9.3"
  }
}
